#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        #include "macros.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hml: home_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_MOD_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            // Triggers on Left Side Keys

            hold-trigger-key-positions = <
                // 0 1 2 3 4 5  // 1st row left
                6 7 8 9 10 11  // 1st row right
                // 12 13 14 15 16 17  // 2nd row left
                18 19 20 21 22 23  // 2nd row right
                // 24 25 26 27 28 29  // 3rd row left
                30 31 32 33 34 35  // 3rd row right
                // 36 37 38 39 40 41 42  // 4th row left
                37 38 39 40  // 4th row left mod
                43 44 45 46 47 48 49  // 4th row right
                50 51 52 53  // thumb cluster left
                54 55 56 57  // thumb cluster right
            >;
        };

        hmr: home_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_MOD_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            // Triggers on Right Side Keys

            hold-trigger-key-positions = <
                0 1 2 3 4 5  // 1st row left
                // 6 7 8 9 10 11  // 1st row right
                12 13 14 15 16 17  // 2nd row left
                // 18 19 20 21 22 23  // 2nd row right
                24 25 26 27 28 29  // 3rd row left
                // 30 31 32 33 34 35  // 3rd row right
                36 37 38 39 40 41 42  // 4th row left
                // 43 44 45 46 47 48 49  // 4th row right
                45 46 47 48  // 4th row right mod
                50 51 52 53  // thumb cluster left
                54 55 56 57  // thumb cluster right
            >;
        };

        mlr: mirror_layer_right {
            compatible = "zmk,behavior-hold-tap";
            label = "MIRROR_LAYER_RIGHT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;

            // Triggers on Right Side Keys

            hold-trigger-key-positions = <
                // 0 1 2 3 4 5  // 1st row left
                6 7 8 9 10 11  // 1st row right
                // 12 13 14 15 16 17  // 2nd row left
                18 19 20 21 22 23  // 2nd row right
                // 24 25 26 27 28 29  // 3rd row left
                30 31 32 33 34 35  // 3rd row right
                // 36 37 38 39 40 41 42  // 4th row left
                43 44 45 46 47 48 49  // 4th row right
                // 50 51 52 53  // thumb cluster left
                54 55 56 57  // thumb cluster right
            >;
        };

        mll: mirror_layer_left {
            compatible = "zmk,behavior-hold-tap";
            label = "MIRROR_LAYER_LEFT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;

            // Triggers on Left Side Keys

            hold-trigger-key-positions = <
                0 1 2 3 4 5  // 1st row left
                // 6 7 8 9 10 11  // 1st row right
                12 13 14 15 16 17  // 2nd row left
                // 18 19 20 21 22 23  // 2nd row right
                24 25 26 27 28 29  // 3rd row left
                // 30 31 32 33 34 35  // 3rd row right
                36 37 38 39 40 41 42  // 4th row left
                // 43 44 45 46 47 48 49  // 4th row right
                50 51 52 53  // thumb cluster left
                // 54 55 56 57  // thumb cluster right
            >;
        };

        rAlt: rAlt {
            compatible = "zmk,behavior-tap-dance";
            label = "RALT";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT>, <&kp RIGHT_ALT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        lParent {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <27 26>;
        };

        rParent {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <28 27>;
        };

        lBrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <14 15>;
        };

        rBrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <15 16>;
        };

        lBracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <38 39>;
        };

        rBracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <40 39>;
        };

        goHome {
            bindings = <&kp CARET>;
            key-positions = <30 31>;
        };

        goEnd {
            bindings = <&kp DOLLAR>;
            key-positions = <32 33>;
        };

        capsWrod {
            bindings = <&caps_word>;
            key-positions = <29 30>;
        };

        window {
            bindings = <&kp LEFT_GUI>;
            key-positions = <50 57>;
        };

        cLayer {
            bindings = <&to 1>;
            key-positions = <55 52>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            bindings = <
&kp GRAVE             &kp N1  &kp N2  &kp N3     &kp N4     &kp N5                   &kp N6         &kp N7     &kp N8     &kp N9      &kp N0     &kp MINUS
&kp NON_US_BACKSLASH  &kp Q   &kp W   &kp E      &kp R      &kp T                    &kp Y          &kp U      &kp I      &kp O       &kp P      &kp EQUAL
&kp ESCAPE            &kp A   &kp S   &kp D      &kp F      &kp G                    &kp H          &kp J      &kp K      &kp L       &kp SEMI   &kp SQT
&kp LEFT_SHIFT        &kp Z   &kp X   &kp C      &kp V      &kp B    &none    &none  &kp N          &kp M      &kp COMMA  &kp PERIOD  &kp SLASH  &kp RIGHT_SHIFT
                                      &kp LCTRL  &kp SPACE  &kp TAB  &none    &none  &kp BACKSPACE  &kp ENTER  &rAlt
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&to 0   &trans  &trans  &trans  &to 4   &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &to 2   &to 3   &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        NumPad {
            bindings = <
&trans  &trans     &trans        &trans     &trans    &trans                         &trans        &trans        &trans        &trans        &trans  &trans
&trans  &trans     &trans        &trans     &trans    &trans                         &trans        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans  &trans
&to 0   &kp SLASH  &kp ASTERISK  &kp MINUS  &kp PLUS  &kp PERCENT                    &trans        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans  &trans
&trans  &trans     &trans        &trans     &trans    &trans       &trans    &trans  &trans        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans
                                 &trans     &trans    &trans       &trans    &trans  &kp NUMBER_0  &trans        &trans
            >;
        };

        Mouse {
            bindings = <
&trans  &trans  &trans          &trans          &trans           &trans                                          &trans           &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans          &mmv MOVE_UP    &trans           &trans                                          &trans           &trans     &trans     &trans  &trans  &trans
&to 0   &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans                                          &mkp MCLK        &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans          &trans          &trans          &trans           &trans     &trans     &trans  &trans  &trans
                                &trans          &trans           &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans     &trans
            >;
        };

        Founction {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans                    &trans  &trans           &trans             &trans  &trans  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans                    &trans  &trans           &trans             &trans  &trans  &trans
&to 0   &kp F5  &kp F6   &kp F7   &kp F8   &trans                    &trans  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &trans  &trans  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans    &trans  &trans  &trans           &trans             &trans  &trans  &trans
                         &trans   &trans   &trans  &trans    &trans  &trans  &trans           &trans
            >;
        };
    };
};
